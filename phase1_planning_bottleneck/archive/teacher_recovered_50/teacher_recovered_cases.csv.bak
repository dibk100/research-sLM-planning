def main():
    H, W = map(int, input().split())
    grid = [input() for _ in range(H)]
    
    min_row, max_row, min_col, max_col = float('inf'), -1, float('inf'), -1
    
    for i in range(H):
        for j in range(W):
            if grid[i][j] == '#':
                min_row = min(min_row, i)
                max_row = max(max_row, i)
                min_col = min(min_col, j)
